+// zshSubPattern reads the word after subscript flags while runeByRune is active.
+// Only an unescaped comma or closing bracket outside balanced brackets ends it.
+// Bracket depth belongs to this pattern, so nested expansions cannot disturb it;
+// those expansions use the ordinary word parser and its nesting/refusal policy.
+// An enclosing double quote makes apostrophes literal pattern characters, while
+// command and parameter expansions remain visible word parts.
+func (p *Parser) zshSubPattern(doubleQuoted bool) *Word {
+	w := &Word{}
+	brackets := 0
+patternLoop:
+	for p.r != runeEOF && p.err == nil {
+		if brackets == 0 && (p.r == ',' || p.r == ']') {
+			break
+		}
+		pos := p.nextPos()
+		switch {
+		case p.r == '$' || p.r == '`' || p.r == '"' || p.r == '\'' && !doubleQuoted:
+			p.pos = pos
+			p.tok = p.regToken(p.r)
+			p.enterNode()
+			part := p.wordPart()
+			p.leaveNode()
+			if part == nil {
+				break patternLoop
+			}
+			w.Parts = append(w.Parts, part)
+		default:
+			p.newLit(p.r)
+		literalLoop:
+			for p.r != runeEOF {
+				switch p.r {
+				case '\\':
+					p.rune() // The escaped rune is data, including brackets and commas.
+				case '[':
+					brackets++
+				case ']':
+					if brackets == 0 {
+						break literalLoop
+					}
+					brackets--
+				case ',':
+					if brackets == 0 {
+						break literalLoop
+					}
+				case '\'':
+					if !doubleQuoted {
+						break literalLoop
+					}
+				case '$', '`', '"':
+					break literalLoop
+				}
+				p.rune()
+			}
+			w.Parts = append(w.Parts, p.lit(pos, p.endLit()))
+		}
+	}
+	if len(w.Parts) == 0 {
+		return nil
+	}
+	return w
+}
